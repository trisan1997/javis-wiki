# macOS
.DS_Store

# Obsidian — keep shared config, ignore per-machine state
.obsidian/workspace*
.obsidian/cache
.obsidian/graph.json

# Wiki backups (created automatically when proposals replace existing content)
.bak/

# ── Persoonsgegevens: NOOIT naar de remote ────────────────────────────────────
# Deze mappen stonden buiten de repo omdat niemand ze had toegevoegd, niet
# omdat iets ze tegenhield. Eén `git add -A` volstond om klantdossiers en
# persoonlijke breinen op GitHub te zetten — onomkeerbaar. Vandaar expliciet.
# klantdossiers (naam, adres, e-mail, telefoon)
customers/
# offertes: klantgegevens + prijzen
quotes/
# gesprekslogs
conversations/
# brein-pagina's per gebruiker (personeel, klanten, investeerder)
users/
# gespreksamenvattingen — zelfde klantgegevens als conversations/
summaries/

# ── Bedrijfsgevoelig: geen persoonsgegevens, wél concurrentievoorsprong ──────
# leveranciersprijzen en marges
material-prices/
# groeistrategie
growth/

# ── Toegevoegd 2026-08-24: mappen die na de regel hierboven zijn ontstaan ─────
# Dezelfde redenering, nieuwere mappen. De repo staat publiek; alles hieronder
# bevat persoonsgegevens of leveranciersprijzen en hoort er niet in.
# dagjournaals van de agents: klantnamen, personeelszaken, medische details
journal/*
!journal/README.md
# leveranciersprijzen — spiegelbeeld van material-prices/
suppliers/
# facturen: klantnaam, adres, e-mail, bedragen
invoices/
# per-agent brein: trainingsdata die uit growth/ en conversations/ citeert
agents/*/
